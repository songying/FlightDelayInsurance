# Deployed FlightDelayInsurance addresses per chain (AC50)
NEXT_PUBLIC_FDI_ADDRESS_31337=0x5FbDB2315678afecb367f032d93F642f64180aa3
NEXT_PUBLIC_FDI_ADDRESS_11155111=
# Optional: RPC override for Sepolia
NEXT_PUBLIC_SEPOLIA_RPC_URL=
# WalletConnect Cloud project id. When set, RainbowKit's connect modal is shown;
# when empty, a plain "Connect browser wallet" button (injected wallet) is shown.
NEXT_PUBLIC_WC_PROJECT_ID=

# --- Classroom demo mode (local Anvil, chain 31337 only). See DEMO.md. ---
# Private keys of Anvil accounts (0), (1) and (2), copied from the list `anvil` prints at startup.
# Put them in web/.env.local (git-ignored), never in this file or in source.
# NEXT_PUBLIC_* values are bundled into the browser JavaScript: use Anvil's dev keys only,
# never a key that holds real funds.
NEXT_PUBLIC_DEMO_INSURER_PK=
NEXT_PUBLIC_DEMO_ALICE_PK=
NEXT_PUBLIC_DEMO_ORACLE_PK=
